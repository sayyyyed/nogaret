---
interface Backlink {
  href: string;
  title: string;
  description?: string;
}

interface Props {
  links: Backlink[];
  heading?: string;
}

const { links, heading = 'Connected notes' } = Astro.props;
---

{links.length > 0 && (
  <section class="backlinks" aria-label={heading}>
    <p class="backlinks-heading">{heading}</p>
    <ul class="backlinks-list">
      {links.map((link) => (
        <li>
          <a href={link.href}>{link.title}</a>
          {link.description && <p>{link.description}</p>}
        </li>
      ))}
    </ul>
  </section>
)}

<style>
  .backlinks {
    background: var(--surface-card);
    border: 1px solid var(--hairline);
    border-radius: 6px;
    margin-top: 2rem;
    padding: 1.25rem 1.5rem;
  }

  .backlinks-heading {
    color: var(--ink);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.06em;
    line-height: 1.33;
    margin: 0 0 0.75rem;
    text-transform: uppercase;
  }

  .backlinks-list {
    display: grid;
    gap: 0.75rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .backlinks-list a {
    color: var(--link-teal);
    font-size: 15px;
    font-weight: 600;
    line-height: 1.5;
    text-decoration: none;
  }

  .backlinks-list a:hover,
  .backlinks-list a:focus-visible {
    text-decoration: underline;
    text-underline-offset: 0.18em;
  }

  .backlinks-list p {
    color: var(--mute);
    font-size: 13px;
    line-height: 1.5;
    margin: 0.2rem 0 0;
  }
</style>