---
import '../../styles/global.css';
import AdminDashboard from '../../components/AdminDashboard';

// Token stored as char codes — not a plain searchable string
// "siahokdurjana" → [115,105,97,104,111,107,100,117,114,106,97,110,97]
const tokenCodes = [115, 105, 97, 104, 111, 107, 100, 117, 114, 106, 97, 110, 97];
---

<!doctype html>
<html lang="en" class="admin-page">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Admin Dashboard</title>
  </head>
  <body class="font-sans antialiased min-h-screen overflow-hidden">
    <div id="admin-shell" data-codes={JSON.stringify(tokenCodes)} class="h-screen w-full relative">
      
      <!-- Error 666 View (Magic Word Gate) -->
      <div id="admin-666" class="absolute inset-0 bg-black flex flex-col items-center justify-center p-6 z-[100] font-mono text-red-500 will-change-transform">
        <div class="max-w-2xl w-full flex flex-col gap-6">
          <h1 class="text-6xl md:text-8xl font-black tracking-tighter blink-text">ERROR 666</h1>
          <div class="text-xl md:text-3xl font-bold uppercase tracking-widest border-y-2 border-red-500 py-4">
            Access Denied
          </div>
          <p class="text-lg md:text-xl opacity-80">
            You are attempting to access a restricted area without proper clearance.
          </p>
          <div class="mt-8">
            <span class="text-red-700">SYSTEM MESSAGE:</span><br/>
            You didn't say the magic word.
          </div>
          
          <div class="mt-12 text-sm text-red-800 opacity-60">
            Waiting for input...
            <span class="inline-block w-2 h-5 bg-red-800 ml-1 animate-pulse"></span>
          </div>
          
          <!-- Mobile fallback input (hidden visually but focusable for mobile keyboards) -->
          <input type="text" id="magic-word-input" class="absolute opacity-0 pointer-events-none" aria-label="Hidden magic word input" autocomplete="off" autocorrect="off" autocapitalize="off" spellcheck="false" />
        </div>
      </div>

      <!-- Login View -->
      <div id="admin-login" style="display:none" class="flex h-full w-full items-center justify-center px-6 py-8 absolute inset-0 z-[50]">
        <div id="admin-card" class="w-full max-w-md rounded-lg border border-[#4d4f46] bg-[#23251d] p-8 shadow-[0_25px_50px_-12px_rgba(0,0,0,0.6)] will-change-transform">
          <div class="admin-card-header mb-8 flex flex-col items-center gap-3 text-center">
            <div class="flex h-14 w-14 items-center justify-center rounded-full border border-[#f7a501]/30 bg-[#f7a501]/15 text-[#f7a501]" aria-hidden="true">
              <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
              </svg>
            </div>
            <h1 class="text-2xl font-extrabold tracking-tight text-[#eeefe9]">Back Access</h1>
            <p class="text-sm text-[#9b9c92]">Enter token to continue</p>
          </div>

          <form id="admin-form" class="flex flex-col gap-4" autocomplete="off">
            <div class="relative">
              <input
                type="password"
                id="admin-token-input"
                class="w-full rounded-md border border-[#4d4f46] bg-[#1a1b16] px-4 py-3 pr-12 font-mono text-base text-[#eeefe9] tracking-wider outline-none transition-[border-color,box-shadow,background-color] duration-200 placeholder:font-sans placeholder:text-[#6c6e63] placeholder:tracking-normal focus:border-[#f7a501] focus:bg-[#23251d] focus:ring-2 focus:ring-[#f7a501]/30"
                placeholder="Token"
                aria-label="Access token"
                autocomplete="off"
                spellcheck="false"
              />
              <button type="button" id="admin-eye" class="absolute right-2 top-1/2 flex h-9 w-9 -translate-y-1/2 items-center justify-center rounded text-[#9b9c92] transition-colors hover:bg-white/10 hover:text-[#eeefe9]" aria-label="Toggle token visibility">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="eye-open">
                  <path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"></path>
                  <circle cx="12" cy="12" r="3"></circle>
                </svg>
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="eye-closed" style="display:none">
                  <path d="M9.88 9.88a3 3 0 1 0 4.24 4.24"></path>
                  <path d="M10.73 5.08A10.43 10.43 0 0 1 12 5c7 0 10 7 10 7a13.16 13.16 0 0 1-1.67 2.68"></path>
                  <path d="M6.61 6.61A13.526 13.526 0 0 0 2 12s3 7 10 7a9.74 9.74 0 0 0 5.39-1.61"></path>
                  <line x1="2" y1="2" x2="22" y2="22"></line>
                </svg>
              </button>
            </div>

            <button type="submit" id="admin-submit" class="admin-submit-btn inline-flex w-full items-center justify-center gap-2 rounded-lg border-2 border-[#b77912] border-t-[#d89205] bg-[#f7a501] px-5 py-3 text-sm font-extrabold leading-tight text-[#23251d] shadow-[0_3px_0_#b77912,0_4px_0_rgba(0,0,0,0.3)] transition-[background-color,border-color,box-shadow,transform] duration-200 ease-out hover:-translate-y-[3px] hover:border-t-[#7c5311] hover:shadow-[0_4px_0_#a4680e,0_5px_0_rgba(0,0,0,0.25)] active:translate-y-[5px] active:shadow-[0_1px_0_#b77912,0_2px_0_rgba(0,0,0,0.2)] disabled:cursor-not-allowed disabled:opacity-70 disabled:shadow-[0_2px_0_#b77912,0_3px_0_rgba(0,0,0,0.15)]">
              <span class="admin-submit-label">Unlock</span>
              <span class="admin-submit-spinner hidden">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" class="animate-spin">
                  <path d="M21 12a9 9 0 1 1-6.219-8.56" />
                </svg>
              </span>
            </button>

            <p id="admin-error" class="admin-error max-h-0 overflow-hidden rounded-md border border-red-800/40 bg-red-900/20 px-3 text-sm font-semibold leading-relaxed text-red-200 opacity-0 transition-[max-height,opacity,padding] duration-300" role="alert"></p>
          </form>

          <a href="/" class="admin-back-link mt-6 block text-center text-sm font-medium text-[#9b9c92] transition-colors hover:text-[#eeefe9] hover:underline hover:underline-offset-4">← Return to site</a>
        </div>
      </div>

      <!-- Dashboard View (React Component) -->
      <div id="admin-app" style="display:none" class="h-full w-full absolute inset-0 z-10">
        <AdminDashboard client:only="react" />
      </div>
    </div>

    <style is:global>
      /* Override global.css for this page */
      html.admin-page,
      html.admin-page body {
        background-color: #1a1b16 !important;
        color: #eeefe9 !important;
      }
      
      html.admin-page body::before {
        display: none !important;
      }

      .admin-error-show {
        max-height: 4rem;
        opacity: 1;
        padding: 0.5rem 0.75rem;
      }
      
      .blink-text {
        animation: blink 2s step-end infinite;
      }
      
      @keyframes blink {
        0%, 100% { opacity: 1; }
        50% { opacity: 0.7; }
      }
    </style>

    <script>
      import { gsap } from 'gsap';

      const shell = document.getElementById('admin-shell');
      if (shell) {
        const codesAttr = shell.getAttribute('data-codes');
        const codes: number[] = codesAttr ? JSON.parse(codesAttr) : [];

        const input = document.getElementById('admin-token-input') as HTMLInputElement | null;
        const form = document.getElementById('admin-form') as HTMLFormElement | null;
        const submitBtn = document.getElementById('admin-submit') as HTMLButtonElement | null;
        const submitLabel = submitBtn?.querySelector('.admin-submit-label') as HTMLElement | null;
        const submitSpinner = submitBtn?.querySelector('.admin-submit-spinner') as HTMLElement | null;
        const errorEl = document.getElementById('admin-error') as HTMLParagraphElement | null;
        const card = document.getElementById('admin-card');
        
        const error666View = document.getElementById('admin-666');
        const loginView = document.getElementById('admin-login');
        const appView = document.getElementById('admin-app');
        
        const eyeBtn = document.getElementById('admin-eye') as HTMLButtonElement | null;
        const eyeOpen = eyeBtn?.querySelector('.eye-open') as SVGElement | null;
        const eyeClosed = eyeBtn?.querySelector('.eye-closed') as SVGElement | null;
        
        const mobileInput = document.getElementById('magic-word-input') as HTMLInputElement | null;

        const KEY = 'adm_sn';
        const MAGIC_KEY = 'adm_magic';
        const MAGIC_WORD = 'jancoktaiasu';
        
        const motionQuery = window.matchMedia('(prefers-reduced-motion: reduce)');
        let magicAccessGranted = false;

        function decode(arr: number[]): string {
          let s = '';
          for (let i = 0; i < arr.length; i++) s += String.fromCharCode(arr[i]);
          return s;
        }

        function isAuthed(): boolean {
          try { return sessionStorage.getItem(KEY) === '1'; } catch { return false; }
        }

        function setAuthed(): void {
          try { sessionStorage.setItem(KEY, '1'); } catch {}
        }
        
        function hasMagicWord(): boolean {
          try { return sessionStorage.getItem(MAGIC_KEY) === '1'; } catch { return false; }
        }
        
        function setMagicWord(): void {
          try { sessionStorage.setItem(MAGIC_KEY, '1'); } catch {}
        }

        function showApp(): void {
          if (!loginView || !appView || !error666View) return;
          error666View.style.display = 'none';
          loginView.style.display = 'none';
          appView.style.display = 'block';
        }
        
        function showLogin(animate = false): void {
          if (!loginView || !error666View) return;
          error666View.style.display = 'none';
          loginView.style.display = 'flex';
          
          if (animate && !motionQuery.matches && card) {
            gsap.from(card, {
              y: 40, opacity: 0, duration: 0.7, ease: 'power4.out',
            });
            gsap.from(card.querySelectorAll('.admin-card-header > *'), {
              y: 15, opacity: 0, duration: 0.5, stagger: 0.08, delay: 0.2, ease: 'power3.out',
            });
            gsap.from(form, {
              y: 15, opacity: 0, duration: 0.5, delay: 0.4, ease: 'power3.out',
            });
            gsap.from(card.querySelector('.admin-back-link'), {
              opacity: 0, duration: 0.4, delay: 0.55, ease: 'power2.out',
            });
          }
        }

        function shakeCard(): void {
          if (motionQuery.matches || !card) return;
          gsap
            .timeline()
            .to(card, { x: -10, duration: 0.05, ease: 'power2.in' })
            .to(card, { x: 10, duration: 0.05, ease: 'power2.in' })
            .to(card, { x: -8, duration: 0.04, ease: 'power2.in' })
            .to(card, { x: 8, duration: 0.04, ease: 'power2.in' })
            .to(card, { x: -4, duration: 0.03, ease: 'power2.in' })
            .to(card, { x: 0, duration: 0.03, ease: 'power2.out' });
        }

        function flashError(msg: string): void {
          if (!errorEl) return;
          errorEl.textContent = msg;
          errorEl.classList.add('admin-error-show');
          shakeCard();
          setTimeout(() => {
            errorEl.classList.remove('admin-error-show');
          }, 3000);
        }

        function setLoading(loading: boolean): void {
          if (!submitLabel || !submitSpinner || !submitBtn) return;
          if (loading) {
            submitLabel.style.display = 'none';
            submitSpinner.style.display = 'inline-flex';
            submitBtn.disabled = true;
          } else {
            submitLabel.style.display = 'inline';
            submitSpinner.style.display = 'none';
            submitBtn.disabled = false;
          }
        }

        // Login Logic
        form?.addEventListener('submit', (e) => {
          e.preventDefault();
          if (!input) return;
          const value = input.value.trim();
          if (!value) {
            flashError('Token required.');
            return;
          }

          setLoading(true);

          setTimeout(() => {
            const expected = decode(codes);
            if (value === expected) {
              setAuthed();
              setLoading(false);

              if (!motionQuery.matches && card) {
                gsap
                  .timeline()
                  .to(card, { scale: 0.96, duration: 0.2, ease: 'power2.in' })
                  .to(card, { opacity: 0, y: -20, duration: 0.3, ease: 'power3.in' })
                  .call(showApp);
              } else {
                showApp();
              }
            } else {
              setLoading(false);
              flashError('Invalid token. Access denied.');
              input.select();
            }
          }, 600);
        });

        eyeBtn?.addEventListener('click', () => {
          if (!input || !eyeOpen || !eyeClosed) return;
          if (input.type === 'password') {
            input.type = 'text';
            eyeOpen.style.display = 'none';
            eyeClosed.style.display = 'inline';
          } else {
            input.type = 'password';
            eyeOpen.style.display = 'inline';
            eyeClosed.style.display = 'none';
          }
        });
        
        // Magic Word Logic
        let keystrokes = '';
        const handleKeystroke = (e: KeyboardEvent) => {
          if (magicAccessGranted) return;
          if (e.key.length === 1 && !e.ctrlKey && !e.metaKey && !e.altKey) {
            keystrokes += e.key.toLowerCase();
            if (keystrokes.length > MAGIC_WORD.length * 2) {
              keystrokes = keystrokes.slice(-MAGIC_WORD.length);
            }
            if (keystrokes.endsWith(MAGIC_WORD)) {
              grantMagicAccess();
            }
          }
        };
        
        const handleMobileMagicInput = (e: Event) => {
          if (magicAccessGranted) return;
          const val = (e.target as HTMLInputElement).value.toLowerCase();
          if (val.includes(MAGIC_WORD)) {
            grantMagicAccess();
          }
        };

        const grantMagicAccess = () => {
          if (magicAccessGranted) return;
          magicAccessGranted = true;
          window.removeEventListener('keydown', handleKeystroke);
          mobileInput?.removeEventListener('input', handleMobileMagicInput);
          setMagicWord();
          if (error666View) {
            if (!motionQuery.matches) {
              gsap.to(error666View, { 
                opacity: 0, 
                scale: 1.1,
                filter: 'blur(10px)',
                duration: 0.8, 
                ease: 'power2.inOut',
                onComplete: () => showLogin(true)
              });
            } else {
              showLogin(true);
            }
          }
        };

        // Determine Initial State
        if (isAuthed()) {
          showApp();
        } else if (hasMagicWord()) {
          showLogin(true);
        } else {
          // Show 666 Error and listen for magic word
          if (error666View) {
            error666View.style.display = 'flex';
            window.addEventListener('keydown', handleKeystroke);
            
            // Mobile support: listen to the hidden input
            if (mobileInput) {
              error666View.addEventListener('click', () => mobileInput.focus());
              mobileInput.addEventListener('input', handleMobileMagicInput);
            }
            
            // Check query param as fallback
            const urlParams = new URLSearchParams(window.location.search);
            if (urlParams.get('word') === MAGIC_WORD) {
              grantMagicAccess();
            }
          }
        }
      }
    </script>
  </body>
</html>
