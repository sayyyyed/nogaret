---
import '../styles/global.css';

// Token stored as char codes — not a plain searchable string
// "siahokdurjana" → [115,105,97,104,111,107,100,117,114,106,97,110,97]
const tokenCodes = [115, 105, 97, 104, 111, 107, 100, 117, 114, 106, 97, 110, 97];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Admin</title>
  </head>
  <body class="bg-[#23251d] text-white font-['IBM_Plex_Sans',sans-serif] antialiased min-h-screen overflow-x-hidden">
    <div id="admin-shell" data-codes={JSON.stringify(tokenCodes)}>
      <!-- Login View -->
      <div id="admin-login" class="flex min-h-screen items-center justify-center px-6 py-8">
        <div id="admin-card" class="w-full max-w-md rounded-lg border border-gray-700 bg-[#33342d] p-8 shadow-[0_25px_50px_-12px_rgba(0,0,0,0.6)] will-change-transform">
          <div class="admin-card-header mb-8 flex flex-col items-center gap-3 text-center">
            <div class="flex h-14 w-14 items-center justify-center rounded-full border border-[#f7a501]/30 bg-[#f7a501]/15 text-[#f7a501]" aria-hidden="true">
              <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
              </svg>
            </div>
            <h1 class="text-2xl font-extrabold tracking-tight text-white">Back Access</h1>
            <p class="text-sm text-gray-400">Enter token to continue</p>
          </div>

          <form id="admin-form" class="flex flex-col gap-4" autocomplete="off">
            <div class="relative">
              <input
                type="password"
                id="admin-token-input"
                class="w-full rounded-md border border-gray-600 bg-gray-800/60 px-4 py-3 pr-12 font-mono text-base text-white tracking-wider outline-none transition-[border-color,box-shadow,background-color] duration-200 placeholder:font-sans placeholder:text-gray-500 placeholder:tracking-normal focus:border-[#f7a501] focus:bg-gray-800 focus:ring-2 focus:ring-[#f7a501]/30"
                placeholder="Token"
                aria-label="Access token"
                autocomplete="off"
                spellcheck="false"
              />
              <button type="button" id="admin-eye" class="absolute right-2 top-1/2 flex h-9 w-9 -translate-y-1/2 items-center justify-center rounded text-gray-400 transition-colors hover:bg-white/10 hover:text-white" aria-label="Toggle token visibility">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="eye-open">
                  <path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"></path>
                  <circle cx="12" cy="12" r="3"></circle>
                </svg>
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="eye-closed" style="display:none">
                  <path d="M9.88 9.88a3 3 0 1 0 4.24 4.24"></path>
                  <path d="M10.73 5.08A10.43 10.43 0 0 1 12 5c7 0 10 7 10 7a13.16 13.16 0 0 1-1.67 2.68"></path>
                  <path d="M6.61 6.61A13.526 13.526 0 0 0 2 12s3 7 10 7a9.74 9.74 0 0 0 5.39-1.61"></path>
                  <line x1="2" y1="2" x2="22" y2="22"></line>
                </svg>
              </button>
            </div>

            <button type="submit" id="admin-submit" class="admin-submit-btn inline-flex w-full items-center justify-center gap-2 rounded-lg border-2 border-[#b77912] border-t-[#d89205] bg-[#f7a501] px-5 py-3 text-sm font-extrabold leading-tight text-[#23251d] shadow-[0_3px_0_#b77912,0_4px_0_rgba(0,0,0,0.3)] transition-[background-color,border-color,box-shadow,transform] duration-200 ease-out hover:-translate-y-[3px] hover:border-t-[#7c5311] hover:shadow-[0_4px_0_#a4680e,0_5px_0_rgba(0,0,0,0.25)] active:translate-y-[5px] active:shadow-[0_1px_0_#b77912,0_2px_0_rgba(0,0,0,0.2)] disabled:cursor-not-allowed disabled:opacity-70 disabled:shadow-[0_2px_0_#b77912,0_3px_0_rgba(0,0,0,0.15)]">
              <span class="admin-submit-label">Unlock</span>
              <span class="admin-submit-spinner hidden">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" class="animate-spin">
                  <path d="M21 12a9 9 0 1 1-6.219-8.56" />
                </svg>
              </span>
            </button>

            <p id="admin-error" class="admin-error max-h-0 overflow-hidden rounded-md border border-red-800/40 bg-red-900/20 px-3 text-sm font-semibold leading-relaxed text-red-200 opacity-0 transition-[max-height,opacity,padding] duration-300" role="alert"></p>
          </form>

          <a href="/" class="admin-back-link mt-6 block text-center text-sm font-medium text-gray-400 transition-colors hover:text-white hover:underline hover:underline-offset-4">← Return to site</a>
        </div>
      </div>

      <!-- Dashboard View (hidden until authed) -->
      <div id="admin-dashboard" class="min-h-screen" style="display:none">
        <header class="sticky top-0 z-10 flex items-center justify-between border-b border-gray-700 bg-[#33342d] px-6 py-4">
          <div class="flex items-center gap-2.5 text-lg font-extrabold tracking-tight text-white">
            <svg width="28" height="28" viewBox="0 0 48 48" role="img" aria-hidden="true">
              <path d="M9 28c0-9 7-16 17-16 8 0 14 5 14 13 0 8-6 13-15 13H12c-2 0-3-1-3-3v-7Z" fill="#f7a501" />
              <path d="M16 15 12 8m10 4-1-8m9 10 5-7" stroke="#23251d" stroke-linecap="round" stroke-width="3" />
              <path d="M12 32c4-7 6-9 8-5 2 1 7-5 8-3 1 1-1 4-1 5 4-2 7-6 12-9" fill="none" stroke="#23251d" stroke-linecap="round" stroke-linejoin="round" stroke-width="3" />
            </svg>
            <span>Admin Panel</span>
          </div>
          <button id="admin-logout" type="button" class="inline-flex items-center gap-1.5 rounded-md border border-gray-600 bg-white/5 px-3.5 py-2 text-sm font-semibold text-white transition-[background-color,border-color,transform] duration-200 hover:bg-red-900/30 hover:border-red-700/50 hover:text-red-200 active:scale-95">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
              <polyline points="16 17 21 12 16 7"></polyline>
              <line x1="21" y1="12" x2="9" y2="12"></line>
            </svg>
            <span>Logout</span>
          </button>
        </header>

        <div class="mx-auto max-w-4xl px-6 py-12">
          <div class="admin-dash-grid grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
            <div class="admin-dash-card rounded-lg border border-gray-700 bg-[#33342d] p-6 transition-[border-color,transform] duration-200 hover:-translate-y-0.5 hover:border-[#f7a501]/40">
              <span class="mb-2 block text-xs font-bold uppercase tracking-wide text-gray-500">Content</span>
              <h2 class="text-lg font-bold text-white">Blog Posts</h2>
              <p class="admin-dash-count mt-3 mb-4 font-mono text-3xl font-semibold text-[#f7a501]">—</p>
              <a href="/blog/" class="text-sm font-semibold text-gray-400 transition-colors hover:text-[#f7a501] hover:underline hover:underline-offset-4">Manage →</a>
            </div>
            <div class="admin-dash-card rounded-lg border border-gray-700 bg-[#33342d] p-6 transition-[border-color,transform] duration-200 hover:-translate-y-0.5 hover:border-[#f7a501]/40">
              <span class="mb-2 block text-xs font-bold uppercase tracking-wide text-gray-500">Content</span>
              <h2 class="text-lg font-bold text-white">Projects</h2>
              <p class="admin-dash-count mt-3 mb-4 font-mono text-3xl font-semibold text-[#f7a501]">—</p>
              <a href="/projects/" class="text-sm font-semibold text-gray-400 transition-colors hover:text-[#f7a501] hover:underline hover:underline-offset-4">Manage →</a>
            </div>
            <div class="admin-dash-card rounded-lg border border-gray-700 bg-[#33342d] p-6 transition-[border-color,transform] duration-200 hover:-translate-y-0.5 hover:border-[#f7a501]/40">
              <span class="mb-2 block text-xs font-bold uppercase tracking-wide text-gray-500">Content</span>
              <h2 class="text-lg font-bold text-white">Notes</h2>
              <p class="admin-dash-count mt-3 mb-4 font-mono text-3xl font-semibold text-[#f7a501]">—</p>
              <a href="/notes/" class="text-sm font-semibold text-gray-400 transition-colors hover:text-[#f7a501] hover:underline hover:underline-offset-4">Manage →</a>
            </div>
            <div class="admin-dash-card rounded-lg border border-gray-700 bg-[#33342d] p-6 transition-[border-color,transform] duration-200 hover:-translate-y-0.5 hover:border-[#f7a501]/40">
              <span class="mb-2 block text-xs font-bold uppercase tracking-wide text-gray-500">Content</span>
              <h2 class="text-lg font-bold text-white">Research</h2>
              <p class="admin-dash-count mt-3 mb-4 font-mono text-3xl font-semibold text-[#f7a501]">—</p>
              <a href="/research/" class="text-sm font-semibold text-gray-400 transition-colors hover:text-[#f7a501] hover:underline hover:underline-offset-4">Manage →</a>
            </div>
          </div>

          <div class="mt-12">
            <h3 class="mb-4 text-xl font-bold text-white">Quick Actions</h3>
            <div class="flex flex-wrap gap-3">
              <a href="/changelog/" class="rounded-md border border-gray-600 bg-white/5 px-4 py-2.5 text-sm font-semibold text-white transition-[background-color,border-color,transform] duration-200 hover:-translate-y-0.5 hover:bg-[#f7a501]/10 hover:border-[#f7a501]/40 hover:text-[#f7a501] active:scale-95">View Changelog</a>
              <a href="/contact/" class="rounded-md border border-gray-600 bg-white/5 px-4 py-2.5 text-sm font-semibold text-white transition-[background-color,border-color,transform] duration-200 hover:-translate-y-0.5 hover:bg-[#f7a501]/10 hover:border-[#f7a501]/40 hover:text-[#f7a501] active:scale-95">Check Messages</a>
              <a href="/" class="rounded-md border border-gray-600 bg-white/5 px-4 py-2.5 text-sm font-semibold text-white transition-[background-color,border-color,transform] duration-200 hover:-translate-y-0.5 hover:bg-[#f7a501]/10 hover:border-[#f7a501]/40 hover:text-[#f7a501] active:scale-95">Open Site</a>
            </div>
          </div>
        </div>
      </div>
    </div>

    <script>
      import { gsap } from 'gsap';

      const shell = document.getElementById('admin-shell');
      if (shell) {
        const codesAttr = shell.getAttribute('data-codes');
        const codes: number[] = codesAttr ? JSON.parse(codesAttr) : [];

        const input = document.getElementById('admin-token-input') as HTMLInputElement | null;
        const form = document.getElementById('admin-form') as HTMLFormElement | null;
        const submitBtn = document.getElementById('admin-submit') as HTMLButtonElement | null;
        const submitLabel = submitBtn?.querySelector('.admin-submit-label') as HTMLElement | null;
        const submitSpinner = submitBtn?.querySelector('.admin-submit-spinner') as HTMLElement | null;
        const errorEl = document.getElementById('admin-error') as HTMLParagraphElement | null;
        const card = document.getElementById('admin-card');
        const loginView = document.getElementById('admin-login');
        const dashboard = document.getElementById('admin-dashboard');
        const eyeBtn = document.getElementById('admin-eye') as HTMLButtonElement | null;
        const eyeOpen = eyeBtn?.querySelector('.eye-open') as SVGElement | null;
        const eyeClosed = eyeBtn?.querySelector('.eye-closed') as SVGElement | null;
        const logoutBtn = document.getElementById('admin-logout') as HTMLButtonElement | null;

        const KEY = 'adm_sn';
        const motionQuery = window.matchMedia('(prefers-reduced-motion: reduce)');

        function decode(arr: number[]): string {
          let s = '';
          for (let i = 0; i < arr.length; i++) s += String.fromCharCode(arr[i]);
          return s;
        }

        function isAuthed(): boolean {
          try {
            return sessionStorage.getItem(KEY) === '1';
          } catch {
            return false;
          }
        }

        function setAuthed(): void {
          try {
            sessionStorage.setItem(KEY, '1');
          } catch {}
        }

        function clearAuth(): void {
          try {
            sessionStorage.removeItem(KEY);
          } catch {}
        }

        function showDashboard(): void {
          if (!loginView || !dashboard) return;
          loginView.style.display = 'none';
          dashboard.style.display = 'block';
          if (!motionQuery.matches) {
            gsap.from(dashboard.querySelectorAll('.admin-dash-card'), {
              y: 30,
              opacity: 0,
              duration: 0.5,
              stagger: 0.08,
              ease: 'power3.out',
            });
          }
        }

        function showLogin(): void {
          if (!loginView || !dashboard) return;
          dashboard.style.display = 'none';
          loginView.style.display = 'flex';
          if (input) {
            input.value = '';
            input.focus();
          }
        }

        function shakeCard(): void {
          if (motionQuery.matches || !card) return;
          gsap
            .timeline()
            .to(card, { x: -10, duration: 0.05, ease: 'power2.in' })
            .to(card, { x: 10, duration: 0.05, ease: 'power2.in' })
            .to(card, { x: -8, duration: 0.04, ease: 'power2.in' })
            .to(card, { x: 8, duration: 0.04, ease: 'power2.in' })
            .to(card, { x: -4, duration: 0.03, ease: 'power2.in' })
            .to(card, { x: 0, duration: 0.03, ease: 'power2.out' });
        }

        function flashError(msg: string): void {
          if (!errorEl) return;
          errorEl.textContent = msg;
          errorEl.classList.add('admin-error-show');
          shakeCard();
          setTimeout(() => {
            errorEl.classList.remove('admin-error-show');
          }, 3000);
        }

        function setLoading(loading: boolean): void {
          if (!submitLabel || !submitSpinner || !submitBtn) return;
          if (loading) {
            submitLabel.style.display = 'none';
            submitSpinner.style.display = 'inline-flex';
            submitBtn.disabled = true;
          } else {
            submitLabel.style.display = 'inline';
            submitSpinner.style.display = 'none';
            submitBtn.disabled = false;
          }
        }

        form?.addEventListener('submit', (e) => {
          e.preventDefault();
          if (!input) return;
          const value = input.value.trim();
          if (!value) {
            flashError('Token required.');
            return;
          }

          setLoading(true);

          setTimeout(() => {
            const expected = decode(codes);
            if (value === expected) {
              setAuthed();
              setLoading(false);

              if (!motionQuery.matches && card) {
                gsap
                  .timeline()
                  .to(card, { scale: 0.96, duration: 0.2, ease: 'power2.in' })
                  .to(card, { opacity: 0, y: -20, duration: 0.3, ease: 'power3.in' })
                  .call(showDashboard);
              } else {
                showDashboard();
              }
            } else {
              setLoading(false);
              flashError('Invalid token. Access denied.');
              input.select();
            }
          }, 600);
        });

        eyeBtn?.addEventListener('click', () => {
          if (!input || !eyeOpen || !eyeClosed) return;
          if (input.type === 'password') {
            input.type = 'text';
            eyeOpen.style.display = 'none';
            eyeClosed.style.display = 'inline';
          } else {
            input.type = 'password';
            eyeOpen.style.display = 'inline';
            eyeClosed.style.display = 'none';
          }
        });

        logoutBtn?.addEventListener('click', () => {
          clearAuth();
          showLogin();
        });

        // Check existing session
        if (isAuthed()) {
          showDashboard();
        } else {
          input?.focus();
        }

        // Entrance animation
        if (!motionQuery.matches && card) {
          gsap.from(card, {
            y: 40,
            opacity: 0,
            duration: 0.7,
            ease: 'power4.out',
          });
          gsap.from(card.querySelectorAll('.admin-card-header > *'), {
            y: 15,
            opacity: 0,
            duration: 0.5,
            stagger: 0.08,
            delay: 0.2,
            ease: 'power3.out',
          });
          gsap.from(form, {
            y: 15,
            opacity: 0,
            duration: 0.5,
            delay: 0.4,
            ease: 'power3.out',
          });
          gsap.from(card.querySelector('.admin-back-link'), {
            opacity: 0,
            duration: 0.4,
            delay: 0.55,
            ease: 'power2.out',
          });
        }
      }
    </script>
  </body>
</html>